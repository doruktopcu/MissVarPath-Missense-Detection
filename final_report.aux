\newlabel{tab:ablation-headline}{{12}{13}{Group leave-one-out ablation, HistGB held-out macro-F1 $\Delta = \text {baseline} - \text {ablated}$. Positive = removing the group hurt the model (group was useful); negative = removing helped (group was noisy/redundant). Threshold for ``waste'' (max\,$|\Delta |<0.005$ across all four tasks) marked with $\dagger $. Source: \texttt {outputs/reports/feature\_ablation/headline\_histgb.csv}}{table.caption.21}{}}
\@writefile{toc}{\contentsline {paragraph}{Phase B: per-feature permutation importance inside the waste groups.}{14}{section*.22}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Per-feature permutation importance (\texttt  {n\_repeats=10}, macro-F1 drop when each column is independently shuffled on the held-out $20\%$). Only the features that exceed the $0.005$ noise floor on at least one task are shown; full table at \texttt  {outputs/reports/feature\_ablation/per\_feature\_waste.csv}.}}{14}{table.caption.23}\protected@file@percent }
\newlabel{tab:ablation-perfeat}{{13}{14}{Per-feature permutation importance (\texttt {n\_repeats=10}, macro-F1 drop when each column is independently shuffled on the held-out $20\%$). Only the features that exceed the $0.005$ noise floor on at least one task are shown; full table at \texttt {outputs/reports/feature\_ablation/per\_feature\_waste.csv}}{table.caption.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.13}Ablation-optimal Lean model}{14}{subsection.4.13}\protected@file@percent }
\newlabel{sec:lean}{{4.13}{14}{Ablation-optimal Lean model}{subsection.4.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Lean-model HistGB headlines. Both lean models drop 94--97 of the 208 base features and stay within $\sim 0.012$ macro-F1 of the $208$-feature baseline on the headline 4-class task. Lean B recovers about half of Lean A's loss by keeping \texttt  {ditto\_score} and \texttt  {metarnn\_score}.}}{15}{table.caption.24}\protected@file@percent }
\newlabel{tab:lean-headline}{{14}{15}{Lean-model HistGB headlines. Both lean models drop 94--97 of the 208 base features and stay within $\sim 0.012$ macro-F1 of the $208$-feature baseline on the headline 4-class task. Lean B recovers about half of Lean A's loss by keeping \texttt {ditto\_score} and \texttt {metarnn\_score}}{table.caption.24}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Lean B full 10-model leaderboard per task. Italicised values \emph  {improve} on the $208$-feature baseline. The centroid families (NearestCentroid, CosineSimilarity) and KNN consistently benefit from the lean subset: dropping the noisy 68-column \texttt  {chasmplus} basket and the 17 conservation columns helps these distance/centroid models disentangle the remaining signal.}}{15}{table.caption.25}\protected@file@percent }
\newlabel{tab:lean-full}{{15}{15}{Lean B full 10-model leaderboard per task. Italicised values \emph {improve} on the $208$-feature baseline. The centroid families (NearestCentroid, CosineSimilarity) and KNN consistently benefit from the lean subset: dropping the noisy 68-column \texttt {chasmplus} basket and the 17 conservation columns helps these distance/centroid models disentangle the remaining signal}{table.caption.25}{}}
